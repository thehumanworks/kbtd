#!/bin/sh
set -eu

# Load the install's mise.lock (Python and uv), sync the dependencies locked in
# uv.lock into the install's .venv, then return to the caller's directory so
# relative paths (including ./TODO.md) still refer to the user's board.
root=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
exec mise -C "$root" exec --locked -- sh -ec '
    root=$1 caller=$2
    shift 2
    export UV_PROJECT_ENVIRONMENT="$root/.venv" UV_PYTHON="$(command -v python)" UV_PYTHON_DOWNLOADS=never
    uv sync --project "$root" --frozen --no-dev --no-install-project --quiet
    export PYTHONPATH="$root"
    cd "$caller"
    exec "$root/.venv/bin/python" -P -m kbtd "$@"
' kbtd "$root" "$PWD" "$@"
